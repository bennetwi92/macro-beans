# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenvs
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Streamlit
.streamlit/secrets.toml

# Built site data — generated by scripts/site/build_*.py at deploy time
web/data/*.json
web/data/portfolios/*.json
web/v2/data/*.json
web/v2/data/charts/*.json
web/v2/data/reports/*.html

# Price cache — DuckDB store, regenerable via `python -m src.data.refresh`
data/market.duckdb
data/market.duckdb.wal
data/market.duckdb.tmp

# Legacy per-symbol CSV cache — superseded by the DuckDB store (seeded once
# via scripts/tools/seed_duckdb.py, then untracked)
data/stock_history/


# Node test dependencies (jsdom etc. for the web engine tests)
node_modules/

# Scanner-strategy price caches — regenerable via scripts/scanner_strategy/fetch_prices.py
data/scanner_strategy/*.parquet
# Scanner-strategy v2 caches — regenerable via scripts/scanner_strategy_v2/fetch_prices.py
data/scanner_strategy_v2/*.parquet
